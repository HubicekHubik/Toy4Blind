// To get started, press Ctrl+Space to bring up the completion menu and view the available nodes.

// You can also use the buttons in the sidebar to perform actions on nodes.
// Actions currently available include:

// * Enabling / disabling the node
// * Adding the bus to a bus
// * Removing the node
// * Connecting ADC channels

// For more help, browse the DeviceTree documentation at https://docs.zephyrproject.org/latest/guides/dts/index.html
// You can also visit the nRF DeviceTree extension documentation at https://docs.nordicsemi.com/bundle/nrf-connect-vscode/page/guides/ncs_configure_app.html#devicetree-support-in-the-extension

/ {
    aliases {
        adc0 = &adc;
    };

    vbatt {
    compatible = "voltage-divider";
    label = "Voltage divider";
    io-channels = <&adc 7>;
    output-ohms = <510000>;
    full-ohms =  <1510000>;
    power-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
    };

    buttons {
             compatible = "gpio-keys";
             button0: button_0 {
                gpios = <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
                label = "Button 1";
             };
             button1: button_1 {
                gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
                label = "Button 2";
             };
             button2: button_2 {
                gpios = <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
                label = "Button 3";
             };
             button3: button_3 {
                gpios = <&gpio1 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
                label = "Button 4";
             };
             button4: button_4 {
                gpios = <&gpio1 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
                label = "Button 5";
             };
    };
};

&pwm0_default {
    group1 {
        psels = <NRF_PSEL(PWM_OUT0, 0, 2)>;
        /delete-property/ nordic,invert;
    };
};

&uart0_sleep {
    group1 {
        psels = <NRF_PSEL(UART_TX, 1, 11)>;
    };
};

&spi2_default {
    group1 {
        psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
    };
};

&spi2_sleep {
    group1 {
        psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                <NRF_PSEL(SPIM_MOSI, 1, 14)>,
                <NRF_PSEL(SPIM_MISO, 1, 15)>;
        /delete-property/ low-power-enable;
    };
};

&xiao_d {
    gpio-map = <0 0 &gpio0 2 0>,
               <1 0 &gpio0 3 0>,
               <2 0 &gpio0 28 0>,
               <3 0 &gpio0 29 0>,
               <4 0 &gpio0 4 0>,
               <5 0 &gpio0 5 0>,
               <6 0 &gpio1 11 0>,
               <7 0 &gpio1 12 0>,
               <8 0 &gpio1 13 0>,
               <9 0 &gpio1 14 0>,
               <10 0 &gpio1 15 0>;
};

&adc {
   #address-cells = <1>;
   #size-cells = <0>;

  channel@5 {
    reg = <5>;
    zephyr,gain = "ADC_GAIN_1_3";
    zephyr,reference = "ADC_REF_INTERNAL";
    zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
    zephyr,input-positive = <NRF_SAADC_AIN3>;
    zephyr,resolution = <12>;
    zephyr,oversampling = <8>;
   };

  channel@4 {
    reg = <4>;
    zephyr,gain = "ADC_GAIN_1_3";
    zephyr,reference = "ADC_REF_INTERNAL";
    zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
    zephyr,input-positive = <NRF_SAADC_AIN2>;
    zephyr,resolution = <12>;
    zephyr,oversampling = <8>;
   };

};